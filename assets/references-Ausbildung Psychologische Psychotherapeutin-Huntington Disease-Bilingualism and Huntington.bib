@article{calabriaLanguageReconfigurationBilinguals2021,
  title = {Language Reconfiguration in Bilinguals: {{A}} Study with {{Huntington}}'s Disease Patients},
  shorttitle = {Language Reconfiguration in Bilinguals},
  author = {Calabria, Marco and P{\'e}rez, Jes{\'u}s P{\'e}rez and {Mart{\'i}nez-Horta}, Sa{\'u}l and {Horta-Barba}, Andrea and Carceller, Mar and Kulisevsky, Jaime and Costa, Albert},
  year = 2021,
  journal = {Linguistic Approaches to Bilingualism},
  volume = {11},
  number = {4},
  pages = {459--483},
  publisher = {John Benjamins},
  issn = {1879-9264, 1879-9272},
  doi = {10.1075/lab.18022.cal},
  urldate = {2026-02-12},
  abstract = {Abstract The present study investigated language inhibition and cross-language interference as two possible mechanisms of bilingual language control (BLC) that can be affected by Huntington's disease (HD), a neurodegenerative disease (ND) affecting the striatum. To this aim, the study explored the performance of pre-symptomatic and early-stage HD patients in two experimental tasks meant to elicit cross-language interference and language inhibition, including a Stroop task and a language switching task. The results revealed dissociations between these two mechanisms, indicating that language activation or inhibition is related to HD pathology while cross-language interference is not. Switch costs in HD patients were greater than controls in low-demand control conditions of language switching (longer preparation time), while Stroop effects were similar between the two groups of participants. This result was interpreted as a difficulty in overcoming the excessive inhibition applied to non-target language. The BLC processes related to the striatum and subcortical structures are discussed.},
  langid = {english},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\LSFZJREU\lab.18022.html}
}

@article{martinez-hortaImpactBilingualismBrain2019,
  title = {The Impact of Bilingualism on Brain Structure and Function in {{Huntington}}'s Disease},
  author = {{Mart{\'i}nez-Horta}, Saul and Moreu, Andrea and {Perez-Perez}, Jes{\'u}s and Sampedro, Frederic and {Horta-Barba}, Andrea and Pagonabarraga, Javier and {Gomez-Anson}, Beatriz and {Lozano-Martinez}, Gloria Andrea and {Lopez-Mora}, Diego Alfonso and Camacho, Valle and {Fern{\'a}ndez-Le{\'o}n}, Alejandro and Carri{\'o}, Ignasi and Kulisevsky, Jaime},
  year = 2019,
  journal = {Parkinsonism \& Related Disorders},
  volume = {60},
  pages = {92--97},
  issn = {13538020},
  doi = {10.1016/j.parkreldis.2018.09.017},
  urldate = {2026-02-12},
  abstract = {Introduction: Bilingualism exerts neuroprotective effects against neurodegeneration. In Huntington's disease (HD), the systems involved in bilingual control show early compromise, but the effect of bilingualism on the course of HD is unknown. Methods: We addressed the impact of livelong use of bilingualism on the clinical features, brain structure and function in 30 early-mild stage HD patients. Using voxel-wise regression analysis, we explored the effect of levels of use of bilingualism on grey-matter volume (GMV) and 18F-FDG metabolism. Results: Higher use of bilingualism was associated with better performance in inhibitory control and set-shifting independently of age and education and with higher GMV in the inferior frontal gyrus. 18F-FDG data revealed a significant effect on multiple fronto-temporal regions, specifically, in the dorsal anterior cingulate cortex, the anterior insula, the ventromedial orbital prefrontal cortex and the inferior frontal gyrus. These changes contributed to better inhibitory control and set-shifting and to more preserved motor and functional capacity. Conclusion: In HD, lifelong use of bilingualism is associated with structural and metabolic brain changes that have an impact on cognition, movement and functionality. These findings highlight the importance of stimulating cognitive and brain reserve in HD and in other neurodegenerative conditions.},
  langid = {english},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\6ZFS3P2I\Martínez-Horta et al. - 2019 - The impact of bilingualism on brain structure and function in Huntington's disease.pdf}
}

