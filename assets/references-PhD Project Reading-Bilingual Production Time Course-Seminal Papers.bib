@article{bedoreMeasureMattersLanguage2012,
  title = {The Measure Matters: {{Language}} Dominance Profiles across Measures in {{Spanish}}--{{English}} Bilingual Children*},
  shorttitle = {The Measure Matters},
  author = {Bedore, Lisa M. and Pe{\~n}a, Elizabeth D. and Summers, Connie L. and Boerger, Karin M. and Resendiz, Maria D. and Greene, Kai and Bohman, Thomas M. and Gillam, Ronald B.},
  year = 2012,
  journal = {Bilingualism: Language and Cognition},
  volume = {15},
  number = {3},
  pages = {616--629},
  publisher = {Cambridge University Press},
  issn = {1469-1841, 1366-7289},
  doi = {10.1017/S1366728912000090},
  urldate = {2022-01-27},
  abstract = {The purpose of this study was to determine if different language measures resulted in the same classifications of language dominance and proficiency for a group of bilingual pre-kindergarteners and kindergarteners. Data were analyzed for 1029 Spanish--English bilingual pre-kindergarteners who spanned the full range of bilingual language proficiency. Parent questionnaires were used to quantify age of first exposure and current language use. Scores from a short test of semantic and morphosyntactic development in Spanish and English were used to quantify children's performance. Some children who were in the functionally monolingual range based on interview data demonstrated minimal knowledge of their other languages when tested. Current use accounted for more of the variance in language dominance than did age of first exposure. Results indicate that at different levels of language exposure children differed in their performance on semantic and morphosyntax tasks. These patterns suggest that it may be difficult to compare the results of studies that employ different measures of language dominance and proficiency. Current use is likely to be a useful metric of bilingual development that can be used to build a comprehensive picture of child bilingualism.},
  langid = {english},
  keywords = {age of acquisition,dominance,language ability,language proficiency,semantics,syntax}
}

@article{bialystokBilingualismConsequencesMind2012,
  title = {Bilingualism: Consequences for Mind and Brain},
  shorttitle = {Bilingualism},
  author = {Bialystok, Ellen and Craik, Fergus I. M. and Luk, Gigi},
  year = 2012,
  journal = {Trends in Cognitive Sciences},
  volume = {16},
  number = {4},
  pages = {240--250},
  issn = {1364-6613},
  doi = {10.1016/j.tics.2012.03.001},
  urldate = {2022-01-14},
  abstract = {Building on earlier evidence showing a beneficial effect of bilingualism on children's cognitive development, we review recent studies using both behavioral and neuroimaging methods to examine the effects of bilingualism on cognition in adulthood and explore possible mechanisms for these effects. This research shows that bilingualism has a somewhat muted effect in adulthood but a larger role in older age, protecting against cognitive decline, a concept known as `cognitive reserve'. We discuss recent evidence that bilingualism is associated with a delay in the onset of symptoms of dementia. Cognitive reserve is a crucial research area in the context of an aging population; the possibility that bilingualism contributes to cognitive reserve is therefore of growing importance as populations become increasingly diverse.},
  langid = {english}
}

