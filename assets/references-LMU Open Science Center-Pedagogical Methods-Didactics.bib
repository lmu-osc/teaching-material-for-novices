@article{almullaConstructivismLearningTheory2023,
  title = {Constructivism Learning Theory: {{A}} Paradigm for Students' Critical Thinking, Creativity, and Problem Solving to Affect Academic Performance in Higher Education},
  shorttitle = {Constructivism Learning Theory},
  author = {Almulla, Mohammed Abdullatif},
  year = 2023,
  journal = {Cogent Education},
  volume = {10},
  number = {1},
  pages = {2172929},
  issn = {null},
  doi = {10.1080/2331186X.2023.2172929},
  urldate = {2025-05-14},
  abstract = {This study looks at whether creativity and critical thinking help students solve problems and improve their grades by mediating the link between 21st century skills (learning motivation, cooperativity, and interaction with peers, engagement with peers, and a smart classroom environment). The mediating relationship between creativity and critical thinking was discovered using structural equation modelling (SEM) research. The participants in the study were 297 postgraduate and undergraduate students from four faculties at King Faisal University who consented to take part. They were chosen using random sampling and volunteered to take part. Learning motivation, cooperativity, peer interaction, peer engagement, and a smart classroom environment all had a direct positive impact on students' critical thinking and creativity; their critical thinking and creativity had a direct positive impact on their problem solving and academic performance; and their problem solving had a direct positive impact on their academic performance. The hypotheses developed a model for measuring students' critical thinking and creativity, which affect problem-solving skills and thus students' academic performance in Saudi Arabian higher education.},
  keywords = {academic performance,critical thinking,higher education,problem solving,Structural Equation Modelling (SEM)},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\PFGXI2KA\Almulla - 2023 - Constructivism learning theory A paradigm for students’ critical thinking, creativity, and problem.pdf}
}

