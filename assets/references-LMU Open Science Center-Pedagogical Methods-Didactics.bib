@article{disessaWhatChangesConceptual1998,
  title = {What Changes in Conceptual Change?},
  author = {{diSessa}, Andrea A. and {and Sherin}, Bruce L.},
  year = 1998,
  journal = {International Journal of Science Education},
  volume = {20},
  number = {10},
  pages = {1155--1191},
  publisher = {Routledge},
  issn = {0950-0693},
  doi = {10.1080/0950069980201002},
  urldate = {2025-03-26},
  abstract = {This paper has two aims. First, it reviews literature about conceptual change and about the study of concepts more broadly. The principal claim is that much prior work has suffered from inexplicitness and imprecision in terms of what constitutes a concept. Second, we introduce a theory of one particular type of concept. A coordination class is a systematic collection of strategies for reading a certain type of information out from the world. We identify both structural components and performance properties of coordination classes. Using this theory, we analyse protocol data from a student with respect to the difficult concept of force in Newtonian mechanics.}
}

