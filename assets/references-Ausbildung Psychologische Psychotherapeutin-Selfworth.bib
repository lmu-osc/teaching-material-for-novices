  series = {{Beltz Therapie-Tools}},
  edition = {1. Auflage},
  publisher = {Julius Beltz GmbH \& Co. KG},
  address = {Weinheim},
  abstract = {Selbstbewusstsein macht stark {$\bullet$} Kreativ am Selbstbewusstsein arbeiten {$\bullet$} Basierend auf Erkenntnissen der Positiven Psychologie, Resilienz- und Gl\"ucksforschung Mut und Vertrauen vermitteln Selbstbewusstsein und Vertrauen in sich selbst zu haben, sind Grundsteine f\"ur eine gesunde Psyche. Nur so kann man Neues angehen, mutig sein und damit weitere Schritte in der Pers\"onlichkeitsentwicklung gehen. \"Ubungen wie >>Die Was-soll\textasciiacute s-Liste<<, >>Grenzen tun gut<<, >>Richtig wichtig<< oder >>Ein Leben wie gemalt<< helfen Klient:innen auf diesem Weg und sind von therapeutischer Seite flexibel und spontan einzusetzen. {$\bullet$} 67 kurzweilige und humorvolle \"Ubungen, Arbeits- und Informationsbl\"atter {$\bullet$} Transdiagnostisch und f\"ur alle Therapiephasen geeignet {$\bullet$} F\"ur Psychotherapie, Beratung, Coaching und Training},
