@article{havenPromotingTrustResearch2022,
  title = {Promoting Trust in Research and Researchers: {{How}} Open Science and Research Integrity Are Intertwined},
  shorttitle = {Promoting Trust in Research and Researchers},
  author = {Haven, Tamarinde and Gopalakrishna, Gowri and Tijdink, Joeri and {van der Schot}, Dorien and Bouter, Lex},
