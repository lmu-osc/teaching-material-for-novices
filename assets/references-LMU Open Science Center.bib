  shorttitle = {``{{Doing Trust}}''},
  author = {Guillemin, Marilys and Gillam, Lynn and Barnard, Emma and Stewart, Paul and Walker, Hannah and Rosenthal, Doreen},
  year = 2016,
  journal = {Journal of Empirical Research on Human Research Ethics},
  volume = {11},
