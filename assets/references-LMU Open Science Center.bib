@article{sturmerDeclarativeKnowledgeProfessional2013,
  title = {Declarative Knowledge and Professional Vision in Teacher Education: {{Effect}} of Courses in Teaching and Learning},
  shorttitle = {Declarative Knowledge and Professional Vision in Teacher Education},
  author = {St{\"u}rmer, Kathleen and K{\"o}nings, Karen D. and Seidel, Tina},
  year = 2013,
  journal = {British Journal of Educational Psychology},
  volume = {83},
