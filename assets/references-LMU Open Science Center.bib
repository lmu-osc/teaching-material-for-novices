  langid = {english},
  keywords = {Scientific community,Social sciences},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\9K6BDZLF\Miske et al. - 2026 - Investigating the reproducibility of the social and behavioural sciences.pdf}
}

