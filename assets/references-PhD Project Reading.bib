@article{osterhoutEventrelatedBrainPotentials1992,
  title = {Event-Related Brain Potentials Elicited by Syntactic Anomaly},
  author = {Osterhout, Lee and Holcomb, Phillip J},
  year = 1992,
  journal = {Journal of Memory and Language},
  volume = {31},
