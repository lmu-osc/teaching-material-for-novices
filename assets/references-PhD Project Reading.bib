@article{krollLanguageSelectionBilingual2008,
  title = {Language Selection in Bilingual Speech: {{Evidence}} for Inhibitory Processes},
  shorttitle = {Language Selection in Bilingual Speech},
  author = {Kroll, Judith F. and Bobb, Susan C. and Misra, Maya and Guo, Taomei},
  year = 2008,
