@article{magisteDevelopmentIntraInterlingual1985,
  title = {Development of Intra- and Interlingual Interference in Bilinguals},
  shorttitle = {Stroop Interference},
  author = {M{\"a}giste, Edith},
  year = 1985,
  journal = {Journal of Psycholinguistic Research},
  volume = {14},
  number = {2},
  pages = {137--154},
  issn = {1573-6555},
  doi = {10.1007/BF01067626},
  urldate = {2021-03-11},
  abstract = {Developmental changes in intra- and interlingual interference were followed in 74 German-Swedish bilingual and 15 trilingual subjects using Stroop tasks for vision. The results provide evidence that the differential pattern of interference is mainly determined by language usage. Intra- and interlingual interference follow language dominance patterns in an everchanging process; hence, it is the point of measurement that determines whether equivalent or different amounts of interference are obtained. Stimuli characteristics determine points of language balance but are---like cognitive capabilities---of minor importance for the differential pattern of interference. Stroop task performance cannot be taken as evidence for or against the interdependence hypothesis of bilingual storage, since the Stroop situation does not permit one language to be turned off. Prolonged response times in multilinguals, found in this study, are more congruent with the interdependence hypothesis. By providing this developmental perspective, the current findings can explain previous contradictory results.},
  langid = {english},
  keywords = {bilingualism,interference,Stroop}
}

