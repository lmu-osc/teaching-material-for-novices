  title = {Lexical Access in Bilingual Speakers: {{What}}'s the (Hard) Problem?},
  shorttitle = {Lexical Access in Bilingual Speakers},
  author = {Finkbeiner, Matthew and Gollan, Tamar H. and Caramazza, Alfonso},
  year = 2006,
  journal = {Bilingualism: Language and Cognition},
  volume = {9},
