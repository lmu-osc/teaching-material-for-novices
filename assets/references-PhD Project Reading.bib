}

@article{osterhoutSecondlanguageLearningChanges2008,
  title = {Second-Language Learning and Changes in the Brain},
  author = {Osterhout, Lee and Poliakov, Andrew and Inoue, Kayo and McLaughlin, Judith and Valentine, Geoffrey and Pitkanen, Ilona and {Frenck-Mestre}, Cheryl and Hirschensohn, Julia},
