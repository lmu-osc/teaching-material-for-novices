@incollection{cenozRoleTypologyOrganization2003,
  title = {The Role of Typology in the Organization of the Multilingual Lexicon},
  shorttitle = {Typology in the {{Organization}} of the {{Multilingual Lexicon}}},
  booktitle = {The {{Multilingual Lexicon}}},
  author = {Cenoz, Jasone},
  editor = {Cenoz, Jasone and Hufeisen, Britta and Jessner, Ulrike},
  year = 2003,
  edition = {1},
  pages = {103--116},
  publisher = {Springer Netherlands},
