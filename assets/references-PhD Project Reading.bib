@article{schriefersParallelismProductionNoun1999,
  title = {Parallelism in the Production of Noun Phrases: {{Experiments}} and Reaction Time Models},
  shorttitle = {Parallelism in the Production of Noun Phrases},
  author = {Schriefers, Herbert and {de Ruiter}, J. P. and Steigerwald, M.},
  year = 1999,
  journal = {Journal of Experimental Psychology: Learning, Memory, and Cognition},
  volume = {25},
  number = {3},
  pages = {702--720},
  publisher = {American Psychological Association},
  issn = {0278-7393},
  doi = {10.1037/0278-7393.25.3.702},
  urldate = {2020-11-25},
  abstract = {In 3 experiments, the authors investigated the temporal coordination of the processes involved in the production of noun phrases (NPs). Speakers of German described drawings of colored objects by noun phrases with or without a determiner (e.g., [the] red table). Participants received, for varying amounts of time, advance information about either the color or the object. For a small number of nouns in the response set, advance information about the color led to shorter reaction times for no-determiner NPs than for definite-determiner NPs. For larger numbers of nouns, advance information about the object led to an additional reaction time benefit for definite-determiner NPs. A mathematical model is shown to account for these results. This model assumes that articulation can be initiated only after the grammatical encoding of the whole noun phrase has been completed, but that phonological encoding of the 1st element of an utterance is initiated as soon as the necessary grammatical information is available. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Articulation (Speech),college students,color vs object advance information for German noun phrase,Human Information Storage,Nouns,Phonology,Phrases,Reaction Time,RT in initiation of articulation of noun phrase}
}

