@article{vincenziDifferencesPerceptionTime2003,
  title = {Differences in the Perception and Time Course of Syntactic and Semantic Violations},
  author = {Vincenzi, Marica De and Job, Remo and Di Matteo, Rosalia and Angrilli, Alessandro and Penolazzi, Barbara and Ciccarelli, Laura and Vespignani, Francesco},
  year = 2003,
  journal = {Brain and Language},
  volume = {85},
