@article{indefreyNeuralCorrelateSyntactic2001,
  title = {A Neural Correlate of Syntactic Encoding during Speech Production},
  author = {Indefrey, Peter and Brown, Colin M. and Hellwig, Frauke and Amunts, Katrin and Herzog, Hans and Seitz, R{\"u}diger J. and Hagoort, Peter},
  year = 2001,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {98},
  number = {10},
  pages = {5933--5936},
  publisher = {National Academy of Sciences},
  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.101118098},
  urldate = {2020-12-09},
  abstract = {Spoken language is one of the most compact and structured ways to convey information. The linguistic ability to structure individual words into larger sentence units permits speakers to express a nearly unlimited range of meanings. This ability is rooted in speakers' knowledge of syntax and in the corresponding process of syntactic encoding. Syntactic encoding is highly automatized, operates largely outside of conscious awareness, and overlaps closely in time with several other processes of language production. With the use of positron emission tomography we investigated the cortical activations during spoken language production that are related to the syntactic encoding process. In the paradigm of restrictive scene description, utterances varying in complexity of syntactic encoding were elicited. Results provided evidence that the left Rolandic operculum, caudally adjacent to Broca's area, is involved in both sentence-level and local (phrase-level) syntactic encoding during speaking.},
  chapter = {Biological Sciences},
  copyright = {Copyright \copyright{} 2001, The National Academy of Sciences},
  langid = {english},
  pmid = {11331773},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\WYRYSUEV\Indefrey et al. - 2001 - A neural correlate of syntactic encoding during speech production.pdf}
}

@article{indefreySpatialTemporalSignatures2004,
  title = {The Spatial and Temporal Signatures of Word Production Components},
  author = {Indefrey, P and Levelt, W. J. M},
  year = 2004,
  journal = {Cognition},
  series = {Towards a {{New Functional Anatomy}} of {{Language}}},
  volume = {92},
  number = {1},
  pages = {101--144},
  issn = {0010-0277},
  doi = {10.1016/j.cognition.2002.06.001},
  urldate = {2020-11-12},
  abstract = {This paper presents the results of a comprehensive meta-analysis of the relevant imaging literature on word production (82 experiments). In addition to the spatial overlap of activated regions, we also analyzed the available data on the time course of activations. The analysis specified regions and time windows of activation for the core processes of word production: lexical selection, phonological code retrieval, syllabification, and phonetic/articulatory preparation. A comparison of the word production results with studies on auditory word/non-word perception and reading showed that the time course of activations in word production is, on the whole, compatible with the temporal constraints that perception processes impose on the production processes they affect in picture/word interference paradigms.},
  langid = {english},
  keywords = {Language,Neuroimaging,Word perception,Word production},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\BBXCDQ9P\Indefrey and Levelt - 2004 - The spatial and temporal signatures of word production components.pdf}
}

