@article{boratynska-sumaraLexicalTransferResearch2014,
  title = {Lexical Transfer Research in Third Language Acquisition ({{TLA}}) - {{An}} Overview},
  author = {{Boratynska-Sumara}, Joanna},
  year = 2014,
  journal = {Studia Linguistica Universitatis Iagellonicae Cracoviensis},
  volume = {131},
  pages = {137--148},
  issn = {20834624, 18971059},
  doi = {10.4467/20834624SL.14.007.2015},
  abstract = {The article will review the most relevant research conducted on lexical transfer as a psycholinguistic phenomenon in tertiary language production at the level of the individual. The main purpose is to present the diversity of the experiments and to compare them as regards to the different aspects of Cross Linguistic Influence (CLI) being examined, the approaches to data collection their authors represent, the kinds of trilingual subjects they are concerned with, the parameters of the participants and the outcomes of the studies.},
  langid = {english}
