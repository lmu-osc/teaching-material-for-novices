@article{rucklidgeRetrospectiveReportsChildhood2006,
  title = {Retrospective Reports of Childhood Trauma in Adults with {{ADHD}}},
  author = {Rucklidge, Julia J. and Brown, Deborah L. and Crawford, Susan and Kaplan, Bonnie J.},
  year = 2006,
  journal = {Journal of Attention Disorders},
  volume = {9},
  number = {4},
  pages = {631--641},
  issn = {1087-0547},
  doi = {10.1177/1087054705283892},
  urldate = {2024-06-06},
  abstract = {Objective: Although studies have documented higher prevalence of abuse in children with ADHD, no studies have investigated childhood reports of abuse in individuals identified with ADHD in adulthood. Method: Forty ADHD women, 17 ADHD males, 17 female controls, and 40 male controls complete the Childhood Trauma Questionnaire and other measures of psychosocial functioning. Results: Emotional abuse and neglect are more common among men and women with ADHD as compared to controls. Sexual abuse and physical neglect are more commonly reported by females with ADHD. Although childhood abuse is significantly correlated with depression and anxiety in adulthood, having ADHD is a better predictor of poorer psychosocial functioning in adulthood. Conclusion: Clinicians are alerted that patients with ADHD symptoms have a high probability of childhood abuse.},
  langid = {english},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\THKU88J8\Rucklidge et al. - 2006 - Retrospective Reports of Childhood Trauma in Adult.pdf}
}
