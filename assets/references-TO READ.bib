}

@article{grozingerMethodologicalProblemsInvestigation1975,
  title = {Methodological Problems in the Investigation of Cerebral Potentials Preceding Speech: {{Determining}} the Onset and Suppressing Artefacts Caused by Speech},
  shorttitle = {Methodological Problems in the Investigation of Cerebral Potentials Preceding Speech},
  author = {Gr{\"o}zinger, B. and Kornhuber, H. H. and Kriebel, J{\"u}rgen},
  year = 1975,
  journal = {Neuropsychologia},
  volume = {13},
  number = {3},
  pages = {263--270},
  issn = {0028-3932},
  doi = {10.1016/0028-3932(75)90002-0},
  urldate = {2020-06-05},
  abstract = {Artefact influences on brain potentials preceding speech and phonation are investigated in 42 separate experiments with 17 subjects. The method of time-reversed averaging of tape stored data was used for analysis [13]. The following possible artefact contaminations were proved and/or discussed: GSR, electrical field artefacts, head and lead movements, EMG influences, eye blinks, glossokinetic potentials, positions of reference electrodes and time constants. The elimination of the discussed artefacts supports the intracranial origin of the recorded potentials. Previously reported interhemispheric asymmetries of brain potentials preceding speech and similar activities [4, 6--10] therefore represent a biolectric correlate of hemispheric dominance. R\'esum\'e On a examin\'e les artefacts qui peuvent se manifester pendant l'enregistrement de l'EEG et leurs eff\^et sur l'extraction, par moyennage \`a temps invers\'e, des potentiels corticaux pr\'ec\'edant l'acte de parler et la phonation. Les artefacts suivant ont \'et\'e examin\'es: R\'eflexe electro-dermal, champs \'electrostatiques exterieurs, mouvements de la t\^ete et des c\^ables d'enregistrement, potentiels musculaires, clignements et mouvements des yeux, potentiels glossocin\'etiques, caracteristiques des \'electrodes de r\'eference et constantes de temps. En \'eliminant tous ces artefacts, on d\'emontre l'origine nerveuse des potentiels moyens pr\'ec\'edant l'acte de parler et la phonation. On peut ainsi interpr\^eter les asymmetries des ces potentiels, telles que rapport\'es dans la litterature [4, 6--10], comme des correlats de la dominance h\'emisph\'erique. Zusammenfassung Artefakteinfl\"usse auf Hirnpotentiale vor Sprechen und Phonation wurden mit 17 Versuchspersonen in 42 Versuchen untersucht. F\"ur die Auswertung und Mittelung wurde die Methode der bewegungsgetriggerten R\"uckw\"artsanalyse mittels Computer (PDP 12) verwendet [13]. Folgende Artefaktquellen wurden untersucht und/oder diskutiert: Galvanischer Hautreflex, elektrische Feldartefakte, Kopfwackel- und Kabelwackelartefakte, \"Uberlagerungen durch Muskelpotentiale, Lidschl\"age und Augenbewegungen, glossokinetische Potentiale, Referenzelektroden und Zeitkonstanten. Die weitgehende Eliminierung der untersuchten Artefaktm\"oglichkeiten best\"atigt den intrakraniellen Ursprung der Potentiale vor Sprechen und Phonation. Die publizierten Seitendifferenzen der Hirnpotentiale [4, 6--10] k\"onnen deswegen als bioelektrisches Korrelat zur Hemisph\"arendominanz interpretiert werden.},
  langid = {english}
}

@article{grundyNeuralCorrelatesCognitive2017a,
  title = {Neural Correlates of Cognitive Processing in Monolinguals and Bilinguals},
  author = {Grundy, John and Anderson, John and Bialystok, Ellen},
  year = 2017,
  journal = {Annals of the New York Academy of Sciences},
  volume = {1396},
  doi = {10.1111/nyas.13333},
  abstract = {The present paper reviews the neural correlates of cognitive control associated with bilingualism. We demonstrate that lifelong practice managing two languages orchestrates global changes to both structure and function of the brain. Compared to monolinguals, bilinguals generally show greater gray matter volume, especially in perceptual/motor regions, greater white matter integrity, and greater functional connectivity between gray matter regions. These changes complement EEG findings showing that bilinguals devote neural resources earlier than monolinguals. Parallel functional findings emerge from the fMRI literature: Bilinguals show reduced frontal activity suggesting that they do not need to rely on top-down mechanisms to the same extent as monolinguals. This shift for bilinguals to rely more on subcortical/posterior regions, which we term the bilingual anterior to posterior and subcortical shift (BAPSS), fits with results from cognitive aging studies and helps to explain why bilinguals experience cognitive decline at later stages of development than monolinguals.}
}

