@article{tanNeuralSystemUnderlying2001a,
  title = {The {{Neural System Underlying Chinese Logograph Reading}}},
  author = {Tan, Li Hai and Liu, Ho-Ling and Perfetti, Charles A. and Spinks, John A. and Fox, Peter T. and Gao, Jia-Hong},
  year = 2001,
  journal = {NeuroImage},
