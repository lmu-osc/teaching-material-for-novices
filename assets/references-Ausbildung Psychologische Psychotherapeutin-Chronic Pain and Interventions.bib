@article{gledhillPsychologicalInterventionsUsed2018,
  title = {Psychological Interventions Used to Reduce Sports Injuries: A Systematic Review of Real-World Effectiveness},
  shorttitle = {Psychological Interventions Used to Reduce Sports Injuries},
  author = {Gledhill, Adam and Forsdyke, Dale and Murray, Eliot},
  year = 2018,
  journal = {British Journal of Sports Medicine},
  volume = {52},
  number = {15},
  pages = {967--971},
  issn = {0306-3674, 1473-0480},
  doi = {10.1136/bjsports-2017-097694},
  urldate = {2024-10-30},
  abstract = {Objective To systematically review studies examining the role of psychological interventions in injury prevention. The primary research question was: What is the real-world effectiveness of psychological intervention in preventing sports injuries? Design Mixed methods systematic review with best evidence synthesis. Data sources CINAHL, MEDLINE, PsycARTICLES, PsycINFO, SPORTDiscus, Science Direct and PubMed. Eligibility criteria for selecting studies Randomised controlled trials (RCT), non-RCTs that included a comparison group, before and after study designs and qualitative methods. Studies were required to outline specific unimodal or multimodal psychological interventions used in relation to injury prevention in the real-world setting. Outcome measure Studies were independently appraised with the Mixed Methods Appraisal Tool. Results Thirteen papers (incorporating 14 studies) met the eligibility criteria, of which 93\% (13/14) reported a decrease in injury rates (effect size range=0.2--1.21). There was an overall moderate risk of bias in reporting (52\%). There is a dominance of stress management-based interventions in literature due to the prominence of the model of stress and athletic injury within the area. Summary/conclusions Psychological interventions demonstrate small (0.2) to large (1.21) effects on sports injury rates. The research area demonstrates a cumulative moderate risk in reporting bias (52\%). PROSPERO registration number CRD42016035879.},
  langid = {english},
  keywords = {injury prevention,psychology,review,sport psychology,stress},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\TEDYKWBH\Gledhill et al. - 2018 - Psychological interventions used to reduce sports injuries a systematic review of real-world effect.pdf}
}

