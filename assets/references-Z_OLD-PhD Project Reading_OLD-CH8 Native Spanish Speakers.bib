  author = {Molinaro, Nicola and Su, Jui-Ju and Carreiras, Manuel},
  year = 2016,
  journal = {Brain and Language},
  volume = {155--156},
  pages = {36--43},
  issn = {0093-934X},
  doi = {10.1016/j.bandl.2016.03.002},
  urldate = {2023-05-23},
  abstract = {Many studies have provided evidence for the automaticity and immediacy with which stereotypical knowledge affects our behavior. However, less is known about how such social knowledge interacts with linguistic cues during comprehension. In this ERP sentence processing study we took advantage of the rich grammatical gender morphology of Spanish to explore the processing of role nouns in which stereotype and grammatical cues were simultaneously manipulated, in a factorial design. We show that stereotypical knowledge overrides syntactic cues, highlighting the immediacy with which stereotype knowledge is activated during language comprehension and supporting proposals claiming that social knowledge impacts on language processing differently from other forms of semantics.},
  langid = {english},
  keywords = {Event related potentials,Gender agreement,Gender stereotypes,N400,Sentence comprehension},
