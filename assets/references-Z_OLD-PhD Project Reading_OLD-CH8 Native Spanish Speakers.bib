@article{popovRoleSemanticsRepair2020,
  title = {The Role of Semantics and Repair Processes in Article-Noun Gender Disagreement in {{Italian}}: {{An ERP}} Study},
  shorttitle = {The Role of Semantics and Repair Processes in Article-Noun Gender Disagreement in {{Italian}}},
  author = {Popov, Sr{\dj}an and Miceli, Gabriele and {\'C}ur{\v c}i{\'c}-Blake, Branislava and Bastiaanse, Roelien},
  year = 2020,
  journal = {Brain and Language},
  volume = {206},
  pages = {104787},
  issn = {0093-934X},
  doi = {10.1016/j.bandl.2020.104787},
  urldate = {2023-05-23},
  abstract = {In this sentence reading study, we used event-related potentials (ERPs) to investigate the processing mechanism of article-noun gender disagreement in two kinds of nouns in Italian. The first are nouns with syntactic gender (il trenoM `train'; la sediaF `chair') for which the processing and repair of gender disagreement entails only one repair option, namely for the article (morphosyntactic repair). The second kind are nouns with semantic gender (il bambinoM `boy', la bambinaF `girl'). Here, there are two options for processing and repairing gender mismatch: repairing the article (morphosyntactic repair) or repairing the noun (both morphosyntactic and semantic repair). Both classes of nouns elicited the LAN, indicating that gender disagreement is always registered at the morphosyntactic level. In addition, the P600 was elicited in both conditions, but was larger for semantic gender, reflecting a more complex repair for this class of nouns.},
  langid = {english},
  keywords = {Agreement,Gender,LAN,P600,Semantic,Syntactic},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\7F8TDDXZ\Popov et al. - 2020 - The role of semantics and repair processes in article-noun gender disagreement in Italian An ERP st.pdf}
}

