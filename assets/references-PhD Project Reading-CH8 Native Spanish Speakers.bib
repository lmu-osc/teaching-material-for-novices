@article{hinojosaEffectsNegativeContent2014,
  title = {Effects of Negative Content on the Processing of Gender Information: {{An}} Event-Related Potential Study},
  shorttitle = {Effects of Negative Content on the Processing of Gender Information},
  author = {Hinojosa, Jos{\'e} A. and Albert, Jacobo and {Fern{\'a}ndez-Folgueiras}, Ux{\'i}a and Santaniello, Gerardo and {L{\'o}pez-Bachiller}, Cristina and Sebasti{\'a}n, Manuel and {S{\'a}nchez-Carmona}, Alberto J. and Pozo, Miguel A.},
