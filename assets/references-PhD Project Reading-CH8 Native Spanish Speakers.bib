@article{caffarraTwoSidesGender2014,
  title = {Two Sides of Gender: {{ERP}} Evidence for the Presence of Two Routes during Gender Agreement Processing},
  shorttitle = {Two Sides of Gender},
  author = {Caffarra, Sendy and Janssen, Niels and Barber, Horacio A.},
  year = 2014,
  journal = {Neuropsychologia},
  volume = {63},
  pages = {124--134},
  issn = {0028-3932},
  doi = {10.1016/j.neuropsychologia.2014.08.016},
  urldate = {2026-03-14},
  abstract = {The present ERP study aimed at providing evidence for the existence of two routes in the brain for the processing of morphosyntactic features during language comprehension; a lexical route which retrieves grammatical properties stored in the lexicon without reliance on formal cues, and a form-based route that takes advantage of sub-lexical units strongly related to a specific grammatical class. In the experiment, we investigated grammatical gender agreement processing in Spanish article--noun word pairs using a grammaticality judgment task. Article--noun pairs either agreed or did not agree in gender. Noun transparency was manipulated such that the ending could be strongly associated with a specific gender class (i.e., transparent nouns) or not (i.e., opaque nouns). A visual half-field method was employed and ERPs were recorded in response to the target nouns in order to disentangle the initial hemisphere-specific computations of gender processing. ERP results showed that, while both hemispheres compute agreement dependencies, the left hemisphere is sensitive to the presence of formal gender cues at an early stage (i.e., 350--500ms) indicating the presence of a form-based route. The right hemisphere showed an ERP effect of transparency, but later than the left hemisphere (i.e., 500--750ms). These findings confirm the presence of two routes to gender, which can be differently used depending on the availability of transparent endings. In addition, the results showed hemispheric differences in the time course of the form-based route.},
  keywords = {Grammatical gender agreement,Hemispheric differences,Visual half-field method},
  file = {C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\SYQ7WH33\\Caffarra et al. - 2014 - Two sides of gender ERP evidence for the presence of two routes during gender agreement processing.pdf;C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\WAC6QCTD\\S0028393214002796.html}
}

@article{deloguEventrelatedPotentialsIndex2019,
  title = {Event-Related Potentials Index Lexical Retrieval ({{N400}}) and Integration ({{P600}}) during Language Comprehension},
  author = {Delogu, Francesca and Brouwer, Harm and Crocker, Matthew W.},
  year = 2019,
  journal = {Brain and Cognition},
  volume = {135},
  pages = {103569},
  issn = {0278-2626},
  doi = {10.1016/j.bandc.2019.05.007},
  urldate = {2023-05-23},
  abstract = {The functional interpretation of two salient language-sensitive ERP components -- the N400 and the P600 -- remains a matter of debate. Prominent alternative accounts link the N400 to processes related to lexical retrieval, semantic integration, or both, while the P600 has been associated with syntactic reanalysis or, alternatively, to semantic integration. The often overlapping predictions of these competing accounts in extant experimental designs, however, has meant that previous findings have failed to clearly decide among them. Here, we present an experiment that directly tests the competing hypotheses using a design that clearly teases apart the retrieval versus integration view of the N400, while also dissociating a syntactic reanalysis/reprocessing account of the P600 from semantic integration. Our findings provide support for an integrated functional interpretation according to which the N400 reflects context-sensitive lexical retrieval -- but not integration -- processes. While the observed P600 effects were not predicted by any account, we argue that they can be reconciled with the integration view, if spatio-temporal overlap of ERP components is taken into consideration.},
  langid = {english},
  keywords = {Discourse comprehension,Event-Related Potentials (ERPs),N400,P600,Semantic integration},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\SCUPTQMJ\Delogu et al. - 2019 - Event-related potentials index lexical retrieval (N400) and integration (P600) during language compr.pdf}
}

@article{deresendeProcessingGrammaticalGender2019,
