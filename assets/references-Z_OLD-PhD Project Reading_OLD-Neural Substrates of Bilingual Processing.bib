@incollection{mcclainNeurocognitiveMechanismsSpeech2018,
  title = {The {{Neurocognitive Mechanisms}} of {{Speech Production}}},
  booktitle = {Stevens' {{Handbook}} of {{Experimental Psychology}} and {{Cognitive Neuroscience}}},
  author = {McClain, Rhonda and Goldrick, Matthew},
  editor = {Wixted, John T.},
  year = 2018,
  pages = {1--28},
  publisher = {John Wiley \& Sons, Inc.},
  address = {Hoboken, NJ, USA},
  doi = {10.1002/9781119170174.epcn302},
  urldate = {2020-04-02},
  abstract = {The study of how a speaker produces meaningful utterances is a vital research topic in psychology and cognitive neuroscience, offering a window into not only language itself, but also cognition more broadly. We review neurocognitive and behavioral evidence that supports a common set of principles for theories of the processes underlying speech production: independent levels of representation/processing; parallel activation and (limited) interaction; and structure-sensitive selection and sequencing. We then examine the interaction between speech production and other domains of cognition, reviewing research on monitoring, executive control and attention, and the intention to communicate. This work reveals how production is highly integrated with other domains of cognition, suggesting a number of interesting avenues for future research.},
  isbn = {978-1-119-17016-7 978-1-119-17017-4},
  langid = {english}
}

@article{minagawa-kawaiDifferentBrainStrategies2005,
  title = {Different Brain Strategies Underlie the Categorical Perception of Foreign and Native Phonemes},
  author = {{Minagawa-Kawai}, Yasuyo and Mori, Koichi and Sato, Yutaka},
  year = 2005,
  journal = {Journal of Cognitive Neuroscience},
  volume = {17},
