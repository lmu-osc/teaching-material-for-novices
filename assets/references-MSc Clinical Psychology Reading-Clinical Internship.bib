@article{fernandesRoleEmotionRegulation2023,
  title = {The {{Role}} of {{Emotion Regulation}} and {{Executive Functioning}} in the {{Intervention Outcome}} of {{Children}} with {{Emotional}} and {{Behavioural Problems}}},
  author = {Fernandes, Blossom and Wright, Mark and Essau, Cecilia A.},
