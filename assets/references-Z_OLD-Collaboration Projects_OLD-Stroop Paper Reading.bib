@article{debotMultilingualLexiconModelling2004a,
  title = {The Multilingual Lexicon: {{Modelling}} Selection and Control},
  shorttitle = {The {{Multilingual Lexicon}}},
  author = {De Bot, Kees},
  year = 2004,
  journal = {International Journal of Multilingualism},
  volume = {1},
