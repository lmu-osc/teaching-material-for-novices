  urldate = {2023-09-30},
  abstract = {It still remains unclear whether psychopathological abnormalities described in human 3,4-methylenedioxymethamphetamine users (MDMA users) and d-amphetamine users (AMPH users) existed before the beginning of regular use or if they develop with ongoing use.},
  langid = {english},
  keywords = {Amphetamines,Drug abuse,Ecstasy,MDMA,Neurotoxicity,Psychopathology}
}
