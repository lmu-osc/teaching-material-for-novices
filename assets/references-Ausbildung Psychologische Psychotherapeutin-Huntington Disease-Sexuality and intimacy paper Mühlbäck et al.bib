@article{wakleySexualDysfunction2005,
  title = {Sexual Dysfunction},
  author = {Wakley, Gill},
  year = 2005,
  journal = {Current Obstetrics \& Gynaecology},
  volume = {15},
  number = {1},
  pages = {38--45},
  issn = {0957-5847},
  doi = {10.1016/j.curobgyn.2004.09.005},
  urldate = {2026-05-11},
  abstract = {Sexual dysfunction is common but can present as hidden problems. Patients expect doctors to ask about sexual functioning, but many doctors have had little education and training about sexuality. Personal attitudes may inhibit skills and influence patient management. Key features in the history are whether the problem is primary or secondary, what else happened around the time the difficulty began, and whether it happens consistently or only in certain circumstances. The way patients react in consultations with doctors may shed light on the manner in which they relate to significant others in their sexual life. Physical examination is an important tool. It not only establishes the physical findings, but, if carefully observed, can also reveal as much non-verbal material as the history. Investigations are rarely needed and should be guided by the history, not ordered routinely. Treat each patient as an individual with a unique problem.},
  keywords = {Sexual dysfunction,Sexual health,Sexuality},
  file = {C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\MISLWDQX\\Wakley - 2005 - Sexual dysfunction.pdf;C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\A7GN5TLP\\S0957584704001209.html}
}

