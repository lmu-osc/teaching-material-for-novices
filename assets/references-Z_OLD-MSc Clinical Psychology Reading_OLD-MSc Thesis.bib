  author = {Ota, Miho and Nemoto, Kiyotaka and Nemoto, Miyuki and Numata, Yuriko and Kitabatake, Ayako and Yamada, Yasunori and Shinkawa, Kaoru and Kobayashi, Masatomo and Arai, Tetsuaki},
