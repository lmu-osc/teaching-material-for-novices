}

@article{bakDoesBilingualismInfluence2014,
  title = {Does Bilingualism Influence Cognitive Aging?},
  author = {Bak, Thomas H. and Nissan, Jack J. and Allerhand, Michael M. and Deary, Ian J.},
  year = 2014,
  journal = {Annals of Neurology},
  volume = {75},
  number = {6},
  pages = {959--963},
  issn = {1531-8249},
  doi = {10.1002/ana.24158},
  urldate = {2024-03-18},
  abstract = {Recent evidence suggests a positive impact of bilingualism on cognition, including later onset of dementia. However, monolinguals and bilinguals might have different baseline cognitive ability. We present the first study examining the effect of bilingualism on later-life cognition controlling for childhood intelligence. We studied 853 participants, first tested in 1947 (age = 11 years), and retested in 2008--2010. Bilinguals performed significantly better than predicted from their baseline cognitive abilities, with strongest effects on general intelligence and reading. Our results suggest a positive effect of bilingualism on later-life cognition, including in those who acquired their second language in adulthood. Ann Neurol 2014;75:959--963},
  copyright = {\copyright{} 2014 The Authors Annals of Neurology published by Wiley Periodicals, Inc. on behalf of American Neurological Association. This is an open access article under the terms of the Creative Commons Attribution License, which permits use, distribution and reproduction in any medium, provided the original work is properly cited.},
  langid = {english},
  file = {C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\GL9QSZRF\\Bak et al. - 2014 - Does bilingualism influence cognitive aging.pdf;C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\XVNASDQB\\ana.html}
}

@article{benedictPreliminaryStandardizationNew1995,
  title = {Preliminary Standardization of a New Visuospatial Memory Test with Six Alternate Forms},
  author = {Benedict, Ralph H. B. and Groninger, Lowell},
  year = 1995,
  journal = {The Clinical Neuropsychologist},
  volume = {9},
  number = {1},
  pages = {11--16},
  issn = {1385-4046},
  doi = {10.1080/13854049508402051},
  urldate = {2024-04-21},
  abstract = {Neuropsychological instruments that can be used to measure changes in cognitive function over time are urgently needed. We report the development of a new test of visuospatial memory called the Brief Visuospatial Memory Test (BVMT) with six equivalent, alternate forms. The interform reliability of the test was first demonstrated in a between-groups investigation and then confirmed in a second study using a counterbalanced, repeated measures design. In the third study, BVMT scores were impaired in a sample of traumatically brain-injured adults and significantly correlated with scores derived from the Visual Reproduction subtest of the Wechsler Memory Scale. The BVMT may be a valuable asset to neuropsychological examinations in studies of progressive dementia or treatment outcome.}
}

