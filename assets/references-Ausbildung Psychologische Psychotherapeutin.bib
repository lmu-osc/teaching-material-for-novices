  title = {Defining Disease-Associated Cognitive Decline: A Normative Calculator for {{Huntington}} Disease},
  shorttitle = {H34 {{Defining}} Disease-Associated Cognitive Decline},
  author = {M{\"u}hlb{\"a}ck, Al{\v z}beta and Mana, Josef and Frank, Wiebke and Wallner, Michael and Lindenberg, Katrin S. and Hoffmann, G. Rainer and Klemp{\'i}{\v r}ov{\'a}, Olga and Klemp{\'i}{\v r}, Ji{\v r}{\'i} and Landwehrmeyer, G. Bernhard and Bezdicek, Ondrej and Network, on behalf of the REGISTRY investigators of the European Huntington Disease and Investigators, the Enroll-HD},
  year = 2022,
  journal = {Journal of Neurology, Neurosurgery \& Psychiatry},
  volume = {93},
  number = {Suppl 1},
  pages = {A74-A75},
  publisher = {BMJ Publishing Group Ltd},
  issn = {0022-3050, 1468-330X},
  doi = {10.1136/jnnp-2022-ehdn.198},
  urldate = {2025-07-29},
  abstract = {Background A declining cognitive performance is a hallmark of Huntington Disease (HD). A battery of neuropsychological assessments (Symbol Digit Modalities Test, Stroop Word Reading, Stroop Color Naming and Stroop Interference Test, Trail Making Test A and B, Categorial and Letter Fluency) is part of the standardized assessment for HD. However, the conventions to administer these tests in the context of HD, differ from the original scoring rules. Objectives Aim was to provide appropriate, frequently updated (`living') normative data to allow clinicians to identify disease-associated cognitive decline in diverse HD populations by using a normative calculator minimizing the impact of confounding factors, such as gender, age, language, and education level. Methods The normative sample data, N = 3,267 (60.5\% females; mean age of 46.9 years (SD = 14.61, range 18 to 86) of healthy controls were fitted to Bayesian generalized additive models with age, education, gender, and language as predictors for each cognitive test to stratify the normative dataset. Results With advancing age, there was a nonlinear decline in cognitive performance. Further, performance was dependent on educational levels and language in all tests. Gender had a more limited impact. A web-based, freely accessible normative calculator (https://nc.2mt-software.de/calculator) is provided to assist in defining and isolating disease-associated cognitive deteriorations. Conclusions For defined neuropsychological tests, a freely accessible tool allows to normalize cognitive performance. Thus, the impact of factors confounding disease-associated cognitive decline can be minimized at the level of a single patient examination, assisting research and daily clinical practice.},
  chapter = {H: Clinical care and clinical services},
  copyright = {\copyright{} Author(s) (or their employer(s)) 2022. No commercial re-use. See rights and permissions. Published by BMJ.},
  langid = {english},
  keywords = {Cognition,Huntington Disease,Living Normative Data,Neuropsychological Testing,Online Calculator}
}

@article{mulhallImportanceSatisfactionSex2008,
  title = {Importance of and Satisfaction with Sex among Men and Women Worldwide: {{Results}} of the Global {{Better Sex Survey}}},
  shorttitle = {Importance of and {{Satisfaction}} with {{Sex Among Men}} and {{Women Worldwide}}},
  author = {Mulhall, John and King, Rosie and Glina, Sidney and Hvidsten, Kyle},
  year = 2008,
  journal = {The Journal of Sexual Medicine},
  volume = {5},
  number = {4},
  pages = {788--795},
  issn = {1743-6095},
  doi = {10.1111/j.1743-6109.2007.00765.x},
  urldate = {2026-07-27},
  abstract = {It is now increasingly recognized that sexual health is important to overall good health and well-being.The Global Better Sex Survey (GBSS) explored the sexual aspirations and unmet needs of men and women worldwide.Participant responses to survey questions.Data were collected during 2005 in 27 countries by phone, door-to-door, and street-intercept interview. Data were weighted by demographic characteristics to accurately reflect the general population of each country.Of the 12,563 respondents (men=6,291, women=6,272), 46\% of men and 48\% of women were younger than 40 years, 41\% were 40--59 years, and 11\% were 60 years or older. Nearly all men (91\%) and women (94\%) were married, living with a partner, or in a relationship. All aspects of sex (intercourse, foreplay, orgasm, attraction to partner) were important to men and women. Nearly half (48\%) of men surveyed reported some degree of erectile dysfunction (ED). A significant proportion of men (65\%) were not very satisfied with their erection hardness (63\% of women were not very satisfied with their partner's erection hardness). An association existed between satisfaction with erection hardness and satisfaction with sex life, love and romance, and overall health. Only 7\% of men reported using a prescription medication for ED. However, 74\% of men were willing to take medication to improve their erections if they thought they had ED; 64\% of women would support such a decision.The GBSS reports the sexual needs and desires of men and women worldwide. Erectile function and the effect of ED on aspects of the sexual experience emerged as the most pressing concerns among male participants.},
  file = {C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\Q285UM3X\\Mulhall et al. - 2008 - Importance of and satisfaction with sex among men and women worldwide Results of the global Better.pdf;C\:\\Users\\Sarah von Grebmer\\Zotero\\storage\\HMDRI5HJ\\j.1743-6109.2007.00765.html}
}

@article{murraySpokenLanguageProduction2000,
  title = {Spoken {{Language Production}} in {{Huntington}}'s and {{Parkinson}}'s {{Diseases}}},
  author = {Murray, Laura L.},
  year = 2000,
  journal = {Journal of Speech, Language, and Hearing Research},
  volume = {43},
  number = {6},
  pages = {1350--1366},
  publisher = {American Speech-Language-Hearing Association},
  doi = {10.1044/jslhr.4306.1350},
  urldate = {2026-02-12},
  abstract = {The purpose of this study was to investigate the presence and nature of spoken language deficits in Huntington's (HD) and Parkinson's (PD) diseases. Specifically, the study examined whether (a) the spoken language abilities of patients with HD or PD differ from those of age-matched control participants with no brain damage, (b) HD and PD are associated with similar spoken language profiles, and (c) the spoken language abilities of patients with HD or PD are related to the severity of their motor speech deficits, cognitive impairments, or both. All participants completed picture description tasks and a battery of cognitive and motor speech tests. Syntactic, quantitative, and informativeness measures of spoken language were analyzed. In terms of syntax, patients with HD produced shorter utterances, a smaller proportion of grammatical utterances, a larger proportion of simple sentences, and fewer embeddings per utterance than their non-brain-damaged peers. The HD group also produced utterances that were shorter and syntactically simpler than those of the PD group, despite similar performances on the cognitive and motor speech tests. The only syntactic difference between the PD group and their control group was that patients with PD produced a smaller proportion of grammatical sentences. Although the patient and control participants tended to produce similar amounts of verbal output, less of what the patients said was considered informative. Correlations between language measures and test battery results suggested that the spoken language abilities of patients with HD or PD are related to a variety of neuropsychological and motor speech changes. The implications of these findings for the clinical management of HD and PD are discussed.}
}

