@article{otwinowskaMoreSimilarBetter2019,
  title = {The More Similar the Better? {{Factors}} in Learning Cognates, False Cognates and Non-Cognate Words},
  shorttitle = {The More Similar the Better?},
  author = {Otwinowska, Agnieszka and Szewczyk, Jakub M.},
  year = 2019,
  journal = {International Journal of Bilingual Education and Bilingualism},
  volume = {22},
  number = {8},
  pages = {974--991},
  publisher = {Routledge},
  issn = {1367-0050},
  doi = {10.1080/13670050.2017.1325834},
  urldate = {2024-02-02},
  abstract = {In this study we explored factors that determine the knowledge of L2 words with orthographic neighbours in L1 (cognates and false cognates). We asked 150 Polish learners of English to translate 105 English non-cognate words, cognates, and false-cognates into Polish, and to assess the confidence of each translation. Confidence ratings allows us to employ a novel analytic procedure which disentangles knowing cognates and false cognates from strategic guessing. Mixed-effects logistic regression models revealed that cognates were known better, whereas false cognates were known worse, relative to non-cognate controls. The advantage of knowing cognates, but not false cognates, was modulated by the degree of similarity to their L1 equivalents. The knowledge of cognates and false cognates was not affected by the frequency of their formal equivalent in L1. Based on these findings we conclude how cross-linguistic formal similarity affects L2 word learnability, proposing a mechanism by which cognates and false cognates are acquired.},
  keywords = {cognates,false cognates,orthographic similarity,Vocabulary acquisition},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\UHA9CLRP\Otwinowska and Szewczyk - 2019 - The more similar the better Factors in learning c.pdf}
}

@article{peetersRepresentationProcessingIdentical2013,
  title = {The Representation and Processing of Identical Cognates by Late Bilinguals: {{RT}} and {{ERP}} Effects},
  shorttitle = {The Representation and Processing of Identical Cognates by Late Bilinguals},
  author = {Peeters, David and Dijkstra, Ton and Grainger, Jonathan},
  year = 2013,
  journal = {Journal of Memory and Language},
  volume = {68},
  number = {4},
  pages = {315--332},
  issn = {0749596X},
  doi = {10.1016/j.jml.2012.12.003},
  urldate = {2020-05-07},
  abstract = {Across the languages of a bilingual, translation equivalents can have the same orthographic form and shared meaning (e.g., TABLE in French and English). How such words, called orthographically identical cognates, are processed and represented in the bilingual brain is not well understood. In the present study, late French--English bilinguals processed such identical cognates and control words in an English lexical decision task. Both behavioral and electrophysiological data were collected. Reaction times to identical cognates were shorter than for non-cognate controls and depended on both English and French frequency. Cognates with a low English frequency showed a larger cognate advantage than those with a high English frequency. In addition, N400 amplitude was found to be sensitive to cognate status and both the English and French frequency of the cognate words. Theoretical consequences for the processing and representation of identical cognates are discussed.},
  langid = {english},
  file = {C:\Users\Sarah von Grebmer\Zotero\storage\5UMIHQ2P\Peeters et al. - 2013 - The representation and processing of identical cognates by late bilinguals RT and ERP effects.pdf}
}

