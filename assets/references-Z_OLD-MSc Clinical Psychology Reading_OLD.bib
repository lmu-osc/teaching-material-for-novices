@article{derryberryReactiveEffortfulProcesses1997,
  title = {Reactive and Effortful Processes in the Organization of Temperament},
  author = {Derryberry, Douglas and Rothbart, Mary K.},
  year = 1997,
  journal = {Development and Psychopathology},
  volume = {9},
  number = {4},
  pages = {633--652},
  publisher = {Cambridge University Press},
  issn = {1469-2198, 0954-5794},
  doi = {10.1017/S0954579497001375},
  urldate = {2023-10-06},
  abstract = {Self-organization can be approached in terms of developmental processes occurring within and between component systems of temperament. Within-system organization involves progressive shaping of cortical representations by subcortical motivational systems. As cortical representations develop, they feed back to provide motivational systems with enhanced detection and guidance capabilities. These reciprocal influences may amplify the underlying motivational functions and promote excessive impulsivity or anxiety. However, these processes also depend upon interactions arising between motivational and attentional systems. We discuss these between-system effects by considering the regulation of approach motivation by reactive attentional processes related to fear and by more voluntary processes related to effortful control. It is suggested that anxious and impulsive psychopathology may reflect limitations in these dual means of control, which can take the form of overregulation as well as underregulation.},
  langid = {english}
}

