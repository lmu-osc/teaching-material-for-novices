@article{ormelNeuroticismCommonMental2013,
  title = {Neuroticism and {{Common Mental Disorders}}: {{Meaning}} and {{Utility}} of a {{Complex Relationship}}},
  shorttitle = {Neuroticism and {{Common Mental Disorders}}},
  author = {Ormel, Johan and Jeronimus, Bertus F. and Kotov, Roman and Riese, Harri{\"e}tte and Bos, Elisabeth H. and Hankin, Benjamin and Rosmalen, Judith G. M. and Oldehinkel, Albertine J.},
  year = 2013,
