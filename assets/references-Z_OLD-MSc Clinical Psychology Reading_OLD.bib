@article{jonesNoteDetectingStatistical2019,
  title = {A Note on Detecting Statistical Outliers in Psychophysical Data},
  author = {Jones, Pete R.},
  year = 2019,
  journal = {Attention, Perception, \& Psychophysics},
  volume = {81},
  number = {5},
  pages = {1189--1196},
  issn = {1943-393X},
  doi = {10.3758/s13414-019-01726-3},
  urldate = {2023-10-06},
  abstract = {This paper considers how to identify statistical outliers in psychophysical datasets where the underlying sampling distributions are unknown. Eight methods are described, and each is evaluated using Monte Carlo simulations of a typical psychophysical experiment. The best method is shown to be one based on a measure of spread known as Sn. This is shown to be more sensitive than popular heuristics based on standard deviations from the mean, and more robust than non-parametric methods based on percentiles or interquartile range. Matlab code for computing Sn is included.},
  langid = {english},
  keywords = {Cognitive neuroscience,Statistics}
}

@article{kahanRiskSelectionBias2015,
  title = {Risk of Selection Bias in Randomised Trials},
  author = {Kahan, Brennan C. and Rehal, Sunita and Cro, Suzie},
  year = 2015,
  journal = {Trials},
  volume = {16},
  number = {1},
  pages = {405},
  issn = {1745-6215},
  doi = {10.1186/s13063-015-0920-x},
  urldate = {2023-11-06},
  abstract = {Selection bias occurs when recruiters selectively enrol patients into the trial based on what the next treatment allocation is likely to be. This can occur even if appropriate allocation concealment is used if recruiters can guess the next treatment assignment with some degree of accuracy. This typically occurs in unblinded trials when restricted randomisation is implemented to force the number of patients in each arm or within each centre to be the same. Several methods to reduce the risk of selection bias have been suggested; however, it is unclear how often these techniques are used in practice.},
  keywords = {Clinical trial,Randomisation procedure,Randomised controlled trial,Selection bias}
}

@article{kallitsounakiAutismSpectrumDisorder2023,
  title = {Autism {{Spectrum Disorder}} and {{Gender Dysphoria}}/{{Incongruence}}. {{A}} Systematic Literature Review and Meta-Analysis},
  author = {Kallitsounaki, Aimilia and Williams, David M.},
  year = 2023,
  journal = {Journal of Autism and Developmental Disorders},
  volume = {53},
  pages = {3103--3117},
  doi = {10.1007/s10803-022-05517-y},
  abstract = {The suggested overlap between autism spectrum disorder (ASD) and gender dysphoria/incongruence (GD/GI) has been much disputed. This review showed a relationship between ASD traits and GD feelings in the general population and a high prevalence of GD/GI in ASD. Our meta-analyses revealed that the pooled estimate of the prevalence of ASD diagnoses in GD/GI people was 11\% (p {$<$} .001) and the overall effect size of the difference in ASD traits between GD/GI and control people was significant (g = 0.67, p {$<$} .001). Heterogeneity was high in both meta-analyses. We demonstrated that the chances that there is not a link between ASD and GD/GI are negligible, yet the size of it needs further investigation.}
}

