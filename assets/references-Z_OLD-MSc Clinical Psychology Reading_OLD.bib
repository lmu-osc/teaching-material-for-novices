  author = {McGlashan, Thomas H. and Grilo, Carlos M. and Skodol, Andrew E. and Gunderson, John G. and Shea, M. Tracie and Morey, Leslie C. and Zanarini, Mary C. and Stout, Robert L.},
  year = 2000,
  journal = {Acta Psychiatrica Scandinavica},
  volume = {102},
