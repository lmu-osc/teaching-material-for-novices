  author = {De Win, Maartje M. L. and Schilt, Thelma and Reneman, Liesbeth and Vervaeke, Hylke and Jager, Gerry and Dijkink, Sarah and Booij, Jan and {van den Brink}, Wim},
  year = 2006,
  journal = {Journal of Psychopharmacology},
  volume = {20},
  number = {2},
  pages = {226--235},
  publisher = {SAGE Publications Ltd STM},
