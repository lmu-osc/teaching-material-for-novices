@article{dominguezDifferencesInternationalGuidelines2019,
  title = {Differences in International Guidelines Regarding {{EMDR}} for Posttraumatic Stress Disorder: {{Why}} They Diverge and Suggestions for Future Research},
  shorttitle = {Differences in {{International Guidelines Regarding EMDR}} for {{Posttraumatic Stress Disorder}}},
  author = {Dominguez, Sarah and Lee, Christopher W.},
