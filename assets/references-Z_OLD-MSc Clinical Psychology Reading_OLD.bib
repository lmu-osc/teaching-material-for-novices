@article{nijdamBriefEclecticPsychotherapy2012,
  title = {Brief Eclectic Psychotherapy v. Eye Movement Desensitisation and Reprocessing Therapy for Post-Traumatic Stress Disorder: Randomised Controlled Trial},
  shorttitle = {Brief Eclectic Psychotherapy v. Eye Movement Desensitisation and Reprocessing Therapy for Post-Traumatic Stress Disorder},
  author = {Nijdam, Mirjam J. and Gersons, Berthold P. R. and Reitsma, Johannes B. and de Jongh, Ad and Olff, Miranda},
