@article{krollRevisedHierarchicalModel2010,
  title = {The {{Revised Hierarchical Model}}: {{A}} Critical Review and Assessment},
  shorttitle = {The {{Revised Hierarchical Model}}},
  author = {Kroll, Judith F. and Van Hell, Janet G. and Tokowicz, Natasha and Green, David W.},
  year = 2010,
  journal = {Bilingualism: Language and Cognition},
  volume = {13},
  number = {3},
  pages = {373--381},
  issn = {1366-7289},
  doi = {10.1017/S136672891000009X},
  urldate = {2021-03-25},
  abstract = {Brysbaert and Duyck (2009) suggest that it is time to abandon the Revised Hierarchical Model () in favor of connectionist models such as BIA+ () that more accurately account for the recent evidence on nonselective access in bilingual word recognition. In this brief response, we first review the history of the Revised Hierarchical Model (RHM), consider the set of issues that it was proposed to address, and then evaluate the evidence that supports and fails to support the initial claims of the model. Although 15 years of new research findings require a number of revisions to the RHM, we argue that the central issues to which the model was addressed, the way in which new lexical forms are mapped to meaning and the consequence of language learning history for lexical processing, cannot be accounted for solely within models of word recognition.},
  pmcid = {PMC2910435},
  pmid = {20676387}
}

